# Copy to rubriqly-backend/.env and fill in. Never commit the real .env file.

# development | production | test
ENVIRONMENT=development

# Paste the Neon connection string as-is (the dev branch on your Mac, production on Render).
# With no value, a local SQLite file is used.
DATABASE_URL=sqlite:///./rubriqly.db

# Long random string, required in production. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Comma-separated list of frontend origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:5173

# mock = fake repeatable results, free, no key needed
# live = real Jev calls through Vercel AI Gateway (costs money; needs AI_GATEWAY_API_KEY)
JEV_MODE=mock
AI_GATEWAY_API_KEY=

# Reading rubric photos ("Scan a rubric"), through the same gateway and key. Never sees drafts.
# mock = a fixed demo rubric, free (refused in production, so students never get a fake scan)
# live = a real vision model (about half a cent per scan; needs AI_GATEWAY_API_KEY)
SCAN_MODE=mock

# Optional overrides (defaults shown):
# JEV_MODEL=typesafe-ai/jev
# JEV_BASE_URL=https://ai-gateway.vercel.sh/v1
# JEV_TIMEOUT_SECONDS=30
# SCAN_MODEL=google/gemini-2.5-flash   # newer Gemini models need paid gateway credits
# SCAN_TIMEOUT_SECONDS=60
# SESSION_DAYS=30
# LOGIN_FAILURES_BEFORE_LOCK=5
# LOGIN_LOCK_MINUTES=15
# MIN_AGE=13                 # sign-up asks people to confirm they're at least this old
# CLIENT_IP_HEADER=          # header with the visitor's address behind a proxy (set in phase H)

# Limits that protect the Jev budget (days are UTC days):
# MAX_WORDS=10000
# MAX_PARAGRAPHS=60           # each paragraph is one small Jev request for its tags
# JEV_MAX_PARALLEL=4          # Jev requests running at the same time per check
# SIGNUPS_PER_NETWORK_PER_DAY=5
# SIGNUPS_PER_DAY=100
# CHECKS_PER_USER_PER_DAY=30
# CHECKS_PER_DAY=500
# RUBRIC_SCANS_PER_USER_PER_WEEK=5   # any 7 days; counts scans that read a rubric or weren't one
# RUBRIC_SCANS_PER_DAY=200           # whole site, everything that reached the model
